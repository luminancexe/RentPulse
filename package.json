{
  "name": "rentpulse-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "db:push": "npm run db:push --workspace=packages/db",
    "db:seed": "npm run db:seed --workspace=packages/db",
    "test": "npm run test:all",
    "test:all": "sucrase-node tests/run-all.ts",
    "test:db": "sucrase-node tests/verify-database.ts",
    "test:phase4": "sucrase-node tests/verify-phase4.ts",
    "test:phase5": "sucrase-node tests/verify-phase5.ts"
  }
}
